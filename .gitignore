# ==============================================================================
# Disaster Response Coordination Hub (DRCH) - Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Credentials & Secrets (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
.env.local
**/.env.local
.env.development.local
.env.test.local
.env.production.local
env/
**/env/
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.pdf
Sprint-Member-Wise.pdf
docker-compose.override.yml
!.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 2. Frontend (Next.js / React / TypeScript / Node.js)
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/node_modules/

# Next.js Build Output & Cache
.next/
**/.next/
frontend/.next/
out/
**/out/
frontend/out/
build/
**/build/
frontend/build/
dist/
**/dist/

# Package manager files & caches
.pnp
.pnp.js
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store/

# TypeScript & Vercel / Turbopack
*.tsbuildinfo
next-env.d.ts
.vercel/
**/.vercel/
.turbo/
**/.turbo/

# ------------------------------------------------------------------------------
# 3. Backend, Python & AI Workers
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so
.Python

# Virtual Environments (CRITICAL - Keeps repository lightweight)
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
env.bak/
venv.bak/
.env/
backend/.venv/
backend/venv/
ai-workers/.venv/
ai-workers/venv/
ai-workers/text_model/data/external/
ai-workers/text_model/artifacts/

# Python packaging & distribution
develop-eggs/
.eggs/
*.egg-info/
*.egg
parts/
var/
wheels/
share/python-wheels/
*.manifest
*.spec

# Jupyter Notebook Checkpoints & Outputs
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Machine Learning Large Artifacts & Model Checkpoints
*.pt
*.pth
*.onnx
*.bin
*.safetensors
*.ckpt
*.h5

# ------------------------------------------------------------------------------
# 4. Databases, Local Storage & State Files
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.rdb
backend/db/*.db
local_data/

# ------------------------------------------------------------------------------
# 5. Logs, Diagnostics & Temp Files
# ------------------------------------------------------------------------------
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pip-log.txt
pip-delete-this-directory.txt
celerybeat-schedule
celerybeat.pid

# Testing & Coverage
coverage/
**/coverage/
frontend/coverage/
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
cover/

# Scratch & Audit files
scratch/
scratch_*.*
audit.json
frontend/audit.json

# ------------------------------------------------------------------------------
# 6. Operating System Artifacts
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*.cab
*.msi
*.msix
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 7. IDEs & Code Editors
# ------------------------------------------------------------------------------
# Visual Studio Code (keeps team recommended configs, ignores workspace state)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.code-workspace

# JetBrains (PyCharm, WebStorm, IntelliJ)
.idea/
*.iws
*.iml

# Vim / Emacs / Sublime
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.jupyter/

# ------------------------------------------------------------------------------
# 8. Binary Documents (Host externally, not in git)
# ------------------------------------------------------------------------------
documents/

# ------------------------------------------------------------------------------
# 9. Personal / Local AI Assistant Settings & Runtime Outputs
# ------------------------------------------------------------------------------
.claude/settings.local.json
.agents/settings.local.json
.ai/tasks/
.ai/reports/
.ai/handoffs/


