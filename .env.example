# ==============================================================================
# ResQ / DRCH backend - environment template (read by backend/app/config.py and docker-compose)
# Copy this file to .env and fill in the blanks:
#   cp .env.example .env
# Layout: REQUIRED first, then settings needed only for a feature you use, then OPTIONAL settings
# (commented out at their defaults). docs/architecture/env-variables.md explains every variable.
# The AI triage service (ai-workers/) and the model services (models/) read their own environment,
# not this file; see docs/architecture/env-variables.md for theirs.
# ==============================================================================

# ------------------------------------------------------------------------------
# REQUIRED - every environment
# ------------------------------------------------------------------------------
# development | staging | production
APP_ENV=development

# Credentials of the local docker compose PostGIS container (local only; DATABASE_URL below uses them,
# so they must come first).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=drch_db
# Connection string used by the backend (Neon in staging/production).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# 32+ characters, no placeholder words such as "change", "example" or "test-only".
JWT_SECRET=

# ------------------------------------------------------------------------------
# REQUIRED outside development - the backend refuses to start in staging/production without them
# ------------------------------------------------------------------------------
# Generate:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Encrypts staff TOTP secrets. Keep it fixed: changing it locks out every staff MFA.
# (In development it may be left empty; a key derived from JWT_SECRET is used.)
MFA_ENCRYPTION_KEY=
# Bearer token for POST /api/v1/internal/ingest/run (same value as the GitHub secret).
INGEST_TOKEN=
# Comma-separated frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# REQUIRED FOR A FEATURE - set the group for each feature you use
# ------------------------------------------------------------------------------
# Donations. PAYMENT_GATEWAY is mock (signed sandbox, no money moves) or razorpay (test or live keys).
#   mock     -> MOCK_GATEWAY_SECRET is required (generate like JWT_SECRET)
#   razorpay -> RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are required
# An unsupported gateway, or razorpay without its keys, stops startup. See docs/guides/payments.md.
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Email (staff invitations, password reset, notification copies). Required wherever people must
# receive mail (staging, production). Without SMTP_HOST emails are only logged, which is fine locally.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# EMAIL_FROM=
# Base URL of the links inside emails.
# FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# OPTIONAL - Google
# ------------------------------------------------------------------------------
# OAuth web client id for "Sign in with Google" (same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID).
# GOOGLE_CLIENT_ID=
# Geocoding key; without it the backend uses OpenStreetMap Nominatim.
# GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# OPTIONAL - ingestion feeds and background workers
# ------------------------------------------------------------------------------
# Public SACHET CAP feed for Gujarat (IMD Ahmedabad, FSI); unset = SACHET adapter off.
# Use the Gujarat feed: the all-India rss_india.xml holds only the latest 100 alerts, mostly other states.
# SACHET_FEED_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_gujarat.xml
# Live collection stays opt-in by default; the classifier URL does not enable any source.
NEWS_RSS_ENABLED=false
BLUESKY_SEARCH_ENABLED=false
# Bluesky AppView search endpoint (only api.bsky.app / public.api.bsky.app over https are accepted).
# BLUESKY_SEARCH_URL=https://api.bsky.app/xrpc/app.bsky.feed.searchPosts
# Simulated social replay fixture (demo only); off so ingestion health shows real sources only.
SOCIAL_REPLAY_ENABLED=false
# Path to another replay fixture (JSONL); empty = the packaged one. Used only when SOCIAL_REPLAY_ENABLED=true.
# SOCIAL_REPLAY_FILE=
INGEST_INTERVAL_SECONDS=900
INGESTION_WORKER_ENABLED=true

# ------------------------------------------------------------------------------
# OPTIONAL - advisory AI services (unset = triage returns UNAVAILABLE and staff triage manually)
# ------------------------------------------------------------------------------
# Multilingual signal classifier (social/news signal queue only; POST /predict with {"text": ...}).
# Set the real URL only in your local .env and on the deployed service; never commit it.
# DISASTER_CLASSIFIER_URL=https://<classifier-host>/predict
# AI_TRIAGE_URL=http://localhost:8001/triage
# AI_TRIAGE_TOKEN=            # same value must be set on the ai-workers service
# AI_LOW_CONFIDENCE_THRESHOLD=0.6
# DISASTER_CLASSIFIER_URL=https://indicbert-disaster-api.onrender.com/predict
# AI_IMAGE_SERVICE_URL=https://disaster-classifier-api.onrender.com   # base URL (not port 8000)

# ------------------------------------------------------------------------------
# OPTIONAL - Gujarat district boundaries (defaults shown)
# ------------------------------------------------------------------------------
# GeoJSON FeatureCollection of Gujarat districts; empty = the packaged state polygon and PostGIS data are used.
# GEOJSON_GUJARAT_DISTRICTS_URL=
# BOUNDARY_SYNC_ENABLED=true
# BOUNDARY_SYNC_INTERVAL_HOURS=720
# BOUNDARY_SYNC_CHECK_INTERVAL_SECONDS=86400

# ------------------------------------------------------------------------------
# OPTIONAL - sign-in, sessions and dispatch timing (defaults shown; change only with a reason)
# ------------------------------------------------------------------------------
# ACCESS_TOKEN_MINUTES=15
# MFA_TOKEN_MINUTES=5
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# PASSWORD_RESET_TOKEN_MINUTES=15
# INVITATION_TOKEN_HOURS=48
# REFRESH_IDLE_HOURS_STAFF=48
# REFRESH_MAX_HOURS_STAFF=168
# REFRESH_IDLE_HOURS_CITIZEN=720
# REFRESH_MAX_HOURS_CITIZEN=2160
# MAX_ACTIVE_SESSIONS=5
# REFRESH_REUSE_GRACE_SECONDS=10
# Minutes a dispatch may stay unacknowledged before it is flagged overdue.
# DISPATCH_ACK_TIMEOUT_MINUTES=15
# Set false only in automated tests.
# RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# OPTIONAL - build and tooling
# ------------------------------------------------------------------------------
# Commit id reported by /api/v1/health (CD bakes it into the image; docker compose passes it through).
# GIT_SHA=dev
# Non-interactive password for `python -m app.cli create-staff` / `create-admin` / `create-field`.
# Prefer typing it at the prompt; never keep a real password in this file.
# (DRCH_STAFF_PASSWORD and DRCH_FIELD_PASSWORD are older aliases that still work.)
# RESQ_STAFF_PASSWORD=
# RESQ_FIELD_PASSWORD=
