# ==============================================================================
# Disaster Response Coordination Hub (DRCH) - Environment Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Credentials used by local postgres container:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=drch_db

# Unified connection URI (Used by backend & ai-workers):
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 2. Application security & environment (Backend)
# ------------------------------------------------------------------------------
# development | staging | production. Anything other than development makes the backend
# refuse to start unless every required value below is set to a real (non-placeholder) value.
APP_ENV=development
GIT_SHA=dev

# Generate each secret once:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET must be 32+ characters and must not contain words like "change", "secret" or "example".
JWT_SECRET=
# Fernet key that encrypts staff TOTP secrets (do NOT derive from JWT_SECRET in production):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
# Bearer token for POST /api/v1/internal/ingest/run
INGEST_TOKEN=

# Comma-separated browser origins allowed to call the API (required outside development).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Payment gateway: only "mock" (sandbox) is implemented.
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=

# Ingestion feeds (SACHET/CAP automated early warning feed):
# SACHET_FEED_URL=

# ------------------------------------------------------------------------------
# 3. Advisory AI triage service (optional - without it triage returns UNAVAILABLE)
# ------------------------------------------------------------------------------
# AI_TRIAGE_URL=http://localhost:8001/triage
# AI_TRIAGE_TOKEN=            # same value must be set on the ai-workers service
# AI_LOW_CONFIDENCE_THRESHOLD=0.6

# ------------------------------------------------------------------------------
# 5. Geospatial & Boundary Services (Optional)
# ------------------------------------------------------------------------------
# Google Maps Geocoding API key for dynamic boundary and district resolution.
# If omitted, automatically falls back to OpenStreetMap Nominatim (Free, no key needed).
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# GEOJSON_GUJARAT_DISTRICTS_URL=   # empty = sync disabled; packaged polygon + PostGIS data are used
# BOUNDARY_SYNC_INTERVAL_HOURS=720  # Monthly sync interval (30 days)

# ------------------------------------------------------------------------------
# 6. Payment Gateway Configuration (Optional)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

