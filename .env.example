# ==============================================================================
# Disaster Response Coordination Hub (DRCH) - Environment Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Credentials used by local postgres container:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=drch_db

# Unified connection URI (Used by backend & ai-workers):
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 2. Cache & Message Broker (Redis & RabbitMQ / CloudAMQP)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@localhost:5672/

# ------------------------------------------------------------------------------
# 3. Application Security & Authentication (Backend)
# ------------------------------------------------------------------------------
# Generate a secret before starting the backend, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=supersecretkey_change_in_production_32chars_min
# Set DEMO_MODE=true only for an isolated, database-free local demo.
DEMO_MODE=false
APP_ENV=development
GIT_SHA=dev

# Ingestion bearer token for /api/v1/internal/ingest/run
INGEST_TOKEN=local_dev_ingest_token_change_in_staging_and_prod_48chars

# Payment gateway configuration (mock, razorpay, stripe)
PAYMENT_GATEWAY=mock
MOCK_GATEWAY_SECRET=sandbox_local_hmac_secret_for_payment_testing

# ------------------------------------------------------------------------------
# 4. Advisory AI Triage Service & Provider Keys (Optional)
# ------------------------------------------------------------------------------
# Leave empty/omitted for manual fallback triage (defaults to UNAVAILABLE).
# If running the external AI triage service (e.g. ai-workers):
# AI_TRIAGE_URL=http://localhost:8001/triage
# AI_LOW_CONFIDENCE_THRESHOLD=0.6

OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here

# ------------------------------------------------------------------------------
# 5. Geospatial & Boundary Services (Optional)
# ------------------------------------------------------------------------------
# Google Maps Geocoding API key for dynamic boundary and district resolution.
# If omitted, automatically falls back to OpenStreetMap Nominatim (Free, no key needed).
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# BOUNDARY_SYNC_INTERVAL_HOURS=720  # Monthly sync interval (30 days)

# ------------------------------------------------------------------------------
# 6. Transactional Email & Notifications (SMTP / Invitations & Password Reset)
# ------------------------------------------------------------------------------
# In local development without an active SMTP server, leave SMTP_HOST blank
# to enable simulated console logging of invitation and password reset emails.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=notifications@drch.gujarat.gov.in
# SMTP_PASSWORD=your_app_specific_password_here
# EMAIL_FROM=no-reply@drch.gujarat.gov.in
# FRONTEND_URL=http://localhost:3000
# INVITATION_TOKEN_HOURS=48
# PASSWORD_RESET_TOKEN_MINUTES=15

# ------------------------------------------------------------------------------
# 7. Google OAuth 2.0 (Social Sign-In for Citizens and Staff)
# ------------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here


